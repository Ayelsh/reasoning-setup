{
  "name": "dsh-reasoning-setup",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Reasoning-effort setup page for DeepSeek Harness: detects models that expose no thinking levels and edits their llm-pi-ai reasoningEfforts declaration from a settings page",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "verify": "node scripts/build.mjs && node scripts/verify.mjs && node scripts/client-smoke.mjs",
    "client-smoke": "node scripts/client-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "zod": "^4.4.3"
  }
}
